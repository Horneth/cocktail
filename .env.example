# Firebase client config for the optional cloud AI features.
#
# NOT SECRETS. These identify the Firebase project from the browser and ship in
# the JS bundle by design — which is why CI passes them as GitHub repo
# *Variables*, not Secrets. The real Gemini key lives in the Firebase project and
# never touches this repo.
#
# Copy to `.env.local` (gitignored via *.local) and fill in, then push the same
# file to GitHub for CI:
#
#     cp .env.example .env.local     # fill it in
#     gh variable set --env-file .env.local
#
# Leave these unset and the app simply hides every AI entry point and never loads
# the Firebase SDK — a bare checkout is a working offline recipe book.
#
# Where to find them: Firebase console → Project settings (gear) → General →
# Your apps → the Web app → "SDK setup and configuration" → Config.
# Full setup guide: docs/cloud-ai-backend.md

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=cocktails-c2705.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cocktails-c2705
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Firebase console → Build → App Check → Apps → register this web app with
# reCAPTCHA v3. The *site* key goes here; the secret key stays in App Check.
VITE_RECAPTCHA_SITE_KEY=
